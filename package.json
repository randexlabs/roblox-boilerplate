{
    "packageManager": "pnpm@10.33.0",
    "devDependencies": {
        "cspell": "^9.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier-plugin-toml": "^2.0.6"
    },
    "lint-staged": {
        "*.{md,json,toml,yml,yaml}": [
            "prettier --write"
        ],
        "*.{md,txt,json,toml,yml,yaml,lua,luau}": [
            "cspell lint --no-progress --no-summary --no-must-find-files"
        ],
        "*.luau": [
            "mise x -- stylua"
        ]
    },
    "scripts": {
        "prepare": "husky",
        "spellcheck": "cspell lint --no-progress --gitignore --dot ."
    }
}
