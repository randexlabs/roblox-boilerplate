option ClientOutput = "./netclient.luau"
option ServerOutput = "./netserver.luau"
option TypesOutput = "./nettypes.luau"
option Casing = Snake
option SyncValidation = false
option WriteValidations = false
option UsePolling = true

event foo {
    from: Server,
    type: Reliable,
    call: SingleSync,
    data: string
}
